{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "othello-arena-edge",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-08-14",
  "workers_dev": true,
  "build": {
    "command": "worker-build --release --no-panic-recovery"
  },
  "durable_objects": {
    "bindings": [
      { "name": "LOBBY", "class_name": "Lobby" },
      { "name": "GAME_ROOM", "class_name": "GameRoom" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Lobby", "GameRoom"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "othello-arena-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION_CACHE",
      "id": "00000000000000000000000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARCHIVES",
      "bucket_name": "othello-game-archives"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "GAME_EVENTS",
        "queue": "othello-game-events"
      }
    ]
  },
  "assets": {
    "directory": "../../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
