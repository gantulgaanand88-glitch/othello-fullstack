{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "othello-arena-edge",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-08-14",
  "workers_dev": true,
  "build": {
    "command": "node scripts/build-worker.mjs"
  },
  "durable_objects": {
    "bindings": [
      { "name": "LOBBY", "class_name": "Lobby" },
      { "name": "GAME_ROOM", "class_name": "GameRoom" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Lobby", "GameRoom"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "othello-arena-prod",
      "database_id": "51404fb1-50f2-4c2a-bd7e-90a76d58fea5",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION_CACHE",
      "id": "d74e3f4063fc4297a104477a9abf0103"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "GAME_EVENTS",
        "queue": "othello-game-events"
      }
    ]
  },
  "assets": {
    "directory": "../../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
